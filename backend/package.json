{
  "name": "taiz-backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "wrangler": "^4.127.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "db:migrate": "wrangler d1 migrations apply taiz-directory-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply taiz-directory-db --remote",
    "db:seed": "bun run scripts/seed-areas.ts",
    "db:seed:remote": "bun run scripts/seed-areas.ts --remote"
  }
}
